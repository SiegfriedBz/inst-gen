# Copy to .env.local for `pnpm dev`. Never put the real values here.
# The format of both is in docs/specs/harness/app-scaffold/spec.md.

PILOT_PASSPHRASES=
SESSION_SECRET=

# Gemini key for the brand read (decision 0003). From AI Studio, in a Google
# project with no billing account. Without it the brand read fails with
# model_failed; the rest of the app works.
GOOGLE_GENERATIVE_AI_API_KEY=

# Tavily key for the essence search (docs/specs/brand/search-essence). Free
# Researcher plan, no card. Without it search is skipped; the rest of the app
# works.
TAVILY_API_KEY=

# The developer's WhatsApp, with its country code, shown at the end of the
# owner guide (docs/specs/guide/owner-guide). Empty: the line is hidden.
GUIDE_CONTACT=

# Usage counters (docs/specs/platform/usage-counters). One Upstash Redis
# database on the free plan, AWS Singapore, no card. Required on Vercel; off
# Vercel, without them, counts live in the server's memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Daily requests per text model, as model-id=number pairs; empty: the default
# (gemini-3.5-flash-lite=500,gemini-3.8-flash=20).
TEXT_DAILY_REQUESTS=
# The image month (decision 0004); empty: 0.0504 and 8.
IMAGE_PRICE_USD=
IMAGE_MONTH_CAP_USD=
# Essence searches a month (3 Tavily credits each); empty: 300.
SEARCHES_PER_MONTH=

# Paid Gemini image models (decision 0004). Key from a SECOND Google project,
# prepaid with auto-reload off, never the free project above. Without it
# images are off; captions still work.
GOOGLE_IMAGE_API_KEY=
