# Copy to .env.local for `pnpm dev`. Never put the real values here.
# The format of both is in docs/specs/harness/app-scaffold/spec.md.

PILOT_PASSPHRASES=
SESSION_SECRET=

# Gemini key for the brand read (decision 0003). From AI Studio, in a Google
# project with no billing account. Without it the brand read fails with
# model_failed; the rest of the app works.
GOOGLE_GENERATIVE_AI_API_KEY=
