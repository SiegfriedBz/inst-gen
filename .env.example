# Copy to .env.local for `pnpm dev`. Made-up values: never put the real ones here.

# One passphrase per owner, comma-separated. Each ends with a hyphen and the
# owner id (lowercase letters); the part before it is at least 12 characters.
PILOT_PASSPHRASES=lotus-river-moon-sen,blue-wave-harbour-svarga,quiet-stone-path-dev

# Signs the session cookie; at least 32 characters. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-me-with-the-output-of-openssl-rand
